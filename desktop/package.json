{
  "name": "lo2s-pattern-lab-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Offline pixel-perfect LED test pattern and Resolume pixel map generator.",
  "license": "MIT",
  "main": "electron-main.cjs",
  "author": "LO2S Pattern Lab contributors",
  "homepage": "https://github.com/johnjjdave/lo2s-pattern-lab",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnjjdave/lo2s-pattern-lab.git"
  },
  "scripts": {
    "build": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lo2s.patternlab",
    "productName": "LO2S Pattern Lab",
    "artifactName": "LO2S-Pattern-Lab-${version}-Portable.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "icons/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
